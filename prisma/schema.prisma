generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum AiProviderKind {
  openai
  anthropic
  google
  openrouter
  github
}

model AiProvider {
  id           String         @id @default(cuid())
  label        String         @unique
  kind         AiProviderKind
  encryptedKey String
  keyLast4     String
  isDefault    Boolean        @default(false)
  lastTestedAt DateTime?
  lastTestOk   Boolean?
  defaultModel String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  useCaseDefaults UseCaseDefault[]
}

enum AiUseCase {
  llm
  image
  video
  tts
  stt
  music
  research
}

model UseCaseDefault {
  useCase    AiUseCase  @id
  providerId String
  provider   AiProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  model      String
  updatedAt  DateTime   @updatedAt
}
